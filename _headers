# _headers — konfigurasi header HTTP khusus Cloudflare Pages
# File ini otomatis dibaca Cloudflare saat deploy (tidak perlu konfigurasi lain).
# Dokumentasi: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Aset statis jarang berubah -> cache lama di browser + CDN
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

# Data katalog -> cache pendek agar perubahan cepat terlihat
/data/pompa.json
  Cache-Control: public, max-age=300, must-revalidate
  Content-Type: application/json; charset=utf-8
